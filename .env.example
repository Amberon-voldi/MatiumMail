# ─────────────────────────────────────────────────────────────────────────────
# MatiumMail environment variables
# Copy to `.env` for local development and fill in the secrets.
# Production values are set in Netlify → Site configuration → Environment
# variables, marked as secret and scoped to Functions. Never commit real values.
# All variables are validated at startup by src/server/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used for absolute links and origin checks).
APP_URL=http://localhost:3001

# ── Database (MilesWeb MariaDB 11.4) ─────────────────────────────────────────
# Dev and production both use the MilesWeb database; there is no local DB.
# Use a HOSTNAME, not the IP: IPv6-only networks (NAT64) can't reach IPv4 literals.
# Any name pointing at 45.199.139.26 works (TLS is pinned to the certificate, not the name).
DB_HOST=mail.matiumtech.com
DB_PORT=3306
DB_USER=matiumte1_matiummail
# Never commit the real password. Locally: put it in `.env`; Netlify: secret env var.
DB_PASSWORD=
DB_NAME=matiumte1_matiummail
# Max pooled connections per server instance. Keep small: shared hosting caps
# connections per user, and every Netlify function instance has its own pool.
DB_CONNECTION_LIMIT=2

# TLS mode:
#   verify   → TLS required; the server's self-signed certificate is checked by
#              MariaDB 11.4+'s password-bound verification. Survives the server
#              making a new certificate on restart (MilesWeb does). Recommended.
#   pinned   → TLS required; the server certificate must match DB_TLS_CA_PEM_BASE64
#              exactly (SHA-256 pin). Only for a server with a fixed certificate.
#   disabled → plaintext; ONLY accepted when DB_HOST is localhost/127.0.0.1/::1.
DB_TLS=verify
# Only for DB_TLS=pinned: base64 of the server's PEM certificate (public). Get it with:
#   echo | openssl s_client -connect mail.matiumtech.com:3306 -starttls mysql 2>/dev/null \
#     | openssl x509 | base64 | tr -d '\n'
DB_TLS_CA_PEM_BASE64=

# Migrations are applied with `npm run db:migrate:remote` (the app's TLS settings), not the
# Prisma CLI, so no DATABASE_URL is needed.

# ── Mailbox credential encryption ────────────────────────────────────────────
# Key ring: comma-separated "<keyId>:<base64 of 32 random bytes>".
# Generate a key with:  npm run keys:generate
# Rotation: add a new key, switch CREDENTIAL_ACTIVE_KEY_ID, run the re-wrap job,
# then remove the old key.
CREDENTIAL_KEYS=
CREDENTIAL_ACTIVE_KEY_ID=

# ── Sessions ─────────────────────────────────────────────────────────────────
# Idle timeout (sliding) and absolute lifetime. Signed out after 30 days without
# opening the app, and after 90 days regardless.
SESSION_IDLE_HOURS=720
SESSION_ABSOLUTE_DAYS=90

# ── Development only ─────────────────────────────────────────────────────────
# Allow self-signed IMAP/SMTP certificates for localhost mail servers (GreenMail).
# Ignored (always false) in production and for any non-localhost host.
DEV_ALLOW_SELF_SIGNED_LOCAL_MAIL=true
