// =============================================================================
// MatiumMail — DRAFT Prisma schema (Phase 1 proposal, not yet wired to a project)
// =============================================================================
// Conventions
//   * UUIDv7 primary keys (time-ordered → good B-tree locality).
//   * snake_case table/column names in Postgres via @@map / @map.
//   * Every mail-scoped table carries `mailboxId` (denormalised where needed) so
//     that the data-access layer can enforce `WHERE mailbox_id = $authorised`.
//   * IMAP UIDs / UIDVALIDITY / MODSEQ are unsigned 32/64-bit → stored as BigInt.
//   * Full-text `tsvector` columns + GIN indexes are created in a raw SQL
//     migration (Prisma cannot declare them natively); they appear here as
//     `Unsupported("tsvector")`.
//   * Secrets live ONLY in `MailboxCredential`, a separate table that ordinary
//     queries never join, and only the mail-engine service can decrypt.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER // full control of the organisation
  ADMIN // manage domains, mailboxes, users, permissions
  MEMBER // uses mailboxes they have been granted
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TransportSecurity {
  TLS // implicit TLS (IMAPS 993 / SMTPS 465)
  STARTTLS // upgrade on plain port (143 / 587); plaintext fallback is NEVER allowed
}

enum DomainStatus {
  ACTIVE
  DISABLED
}

enum MailboxStatus {
  PENDING_VERIFICATION // created, credentials not yet proven
  ACTIVE
  NEEDS_REAUTH // IMAP/SMTP auth failed (e.g. password changed in mPanel)
  ERROR // repeated non-auth failures (server down, TLS problem…)
  DISABLED // turned off by an admin
}

enum CredentialType {
  PASSWORD
  APP_PASSWORD
  OAUTH2 // future: Gmail / Microsoft 365 providers
}

enum MailboxAccessRole {
  OWNER // the person whose mailbox it is; read, send, manage, archive, delete
  DELEGATE // shared-mailbox member; read, send-as, organise, archive
  READ_ONLY // read & search only (e.g. auditor)
}

enum FolderSpecialUse {
  NONE
  INBOX
  SENT
  DRAFTS
  JUNK
  TRASH
  ARCHIVE
  ALL
  FLAGGED
}

enum QuotaSource {
  IMAP_QUOTA // RFC 2087 / 9208 GETQUOTAROOT
  COMPUTED // sum of message sizes across folders (usage only)
  MANUAL // limit entered by an admin (usage may still be computed)
}

enum ContactSource {
  MANUAL
  AUTO // harvested from recipients the user has sent to
  IMPORTED
}

enum ArchiveTrigger {
  MANUAL
  POLICY // future automated archival
}

enum ArchiveBatchStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL // some messages failed
  FAILED
  CANCELLED
}

enum ArchiveStatus {
  PENDING
  UPLOADED // object written, not yet verified
  VERIFIED // checksum + size + metadata verified → safe to offer removal
  FAILED
}

enum LiveCopyState {
  PRESENT // original still in the live mailbox
  MOVED_TO_TRASH // user chose "move original to Trash"
  EXPUNGED // user confirmed permanent removal from the server
  RESTORED // archived copy was re-uploaded to the live mailbox
  UNKNOWN // live copy disappeared outside our control
}

// -----------------------------------------------------------------------------
// Tenancy & identity
// -----------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  serverProfiles MailServerProfile[]
  domains        Domain[]
  mailboxes      Mailbox[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

/// A human who signs in to the web app. Their sign-in identity is an email
/// address on a registered domain; authentication is delegated to IMAP.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  email           String     @unique // lower-cased, primary sign-in address
  displayName     String?    @map("display_name")
  role            UserRole   @default(MEMBER)
  status          UserStatus @default(ACTIVE)
  /// Optional app-level TOTP (encrypted with the same envelope scheme).
  totpSecretEnc   Bytes?     @map("totp_secret_enc")
  totpEnabledAt   DateTime?  @map("totp_enabled_at")
  preferences     Json       @default("{}") // theme, density, shortcuts, reading-pane position…
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions      Session[]
  mailboxAccess MailboxAccess[]   @relation("AccessUser")
  grantsMade    MailboxAccess[]   @relation("AccessGrantedBy")
  signatures    Signature[]
  composeDrafts ComposeDraft[]
  archiveBatches ArchiveBatch[]

  @@index([organizationId])
  @@map("users")
}

/// Opaque server-side session. The cookie holds a random 256-bit token; only
/// its SHA-256 hash is stored here, so a DB leak cannot be replayed.
model Session {
  id            String    @id // hex(sha256(token))
  userId        String    @map("user_id") @db.Uuid
  activeMailboxId String? @map("active_mailbox_id") @db.Uuid
  mfaVerifiedAt DateTime? @map("mfa_verified_at")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime  @map("expires_at") // sliding idle timeout
  absoluteExpiresAt DateTime @map("absolute_expires_at") // hard cap

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// Mail infrastructure configuration (no code change to add a domain/mailbox)
// -----------------------------------------------------------------------------

/// Connection settings for a mail server. Several domains on the same MilesWeb
/// server share one profile. Values come from MilesWeb — never hard-coded.
model MailServerProfile {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String // e.g. "MilesWeb – server A"
  provider       String            @default("generic-imap") // future: "gmail", "m365"
  imapHost       String            @map("imap_host")
  imapPort       Int               @map("imap_port")
  imapSecurity   TransportSecurity @map("imap_security")
  smtpHost       String            @map("smtp_host")
  smtpPort       Int               @map("smtp_port")
  smtpSecurity   TransportSecurity @map("smtp_security")
  /// Expected TLS server name if it differs from host (never disables verification).
  tlsServername  String?           @map("tls_servername")
  /// Max concurrent IMAP connections we allow ourselves per mailbox.
  maxConnectionsPerMailbox Int     @default(3) @map("max_connections_per_mailbox")
  /// Our own outbound throttle to stay under the provider's sending limits.
  smtpMaxPerHour Int?              @map("smtp_max_per_hour")
  /// Capability snapshot from the last probe (IDLE, QUOTA, CONDSTORE…).
  capabilities   Json?
  verifiedAt     DateTime?         @map("verified_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domains      Domain[]

  @@map("mail_server_profiles")
}

model Domain {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  serverProfileId String       @map("server_profile_id") @db.Uuid
  name            String       @unique // lower-case FQDN, e.g. "noida.fit"
  status          DomainStatus @default(ACTIVE)
  /// If true, a successful IMAP login with an address on this domain creates
  /// the User + Mailbox automatically (owner access). Otherwise admin-only.
  autoProvision   Boolean      @default(false) @map("auto_provision")
  defaultQuotaBytes BigInt?    @map("default_quota_bytes") // used when IMAP QUOTA is unavailable
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serverProfile MailServerProfile @relation(fields: [serverProfileId], references: [id], onDelete: Restrict)
  mailboxes     Mailbox[]

  @@index([organizationId])
  @@map("domains")
}

model Mailbox {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  domainId       String        @map("domain_id") @db.Uuid
  address        String        @unique // lower-case full address
  displayName    String?       @map("display_name") // default "From" name
  status         MailboxStatus @default(PENDING_VERIFICATION)
  statusReason   String?       @map("status_reason")
  /// Per-mailbox settings: remote-image policy, default signature ids,
  /// sent-copy behaviour, folder role overrides, etc.
  settings       Json          @default("{}")

  // --- storage / quota ----------------------------------------------------
  quotaUsedBytes  BigInt?      @map("quota_used_bytes")
  quotaLimitBytes BigInt?      @map("quota_limit_bytes")
  quotaSource     QuotaSource? @map("quota_source")
  quotaCheckedAt  DateTime?    @map("quota_checked_at")

  // --- sync bookkeeping ---------------------------------------------------
  lastSyncAt      DateTime?    @map("last_sync_at")
  lastSyncError   String?      @map("last_sync_error")
  consecutiveFailures Int      @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain           Domain             @relation(fields: [domainId], references: [id], onDelete: Restrict)
  credential       MailboxCredential?
  access           MailboxAccess[]
  folders          MailFolder[]
  messages         MessageMeta[]
  contacts         Contact[]
  signatures       Signature[]
  composeDrafts    ComposeDraft[]
  archiveBatches   ArchiveBatch[]
  archivedMessages ArchivedMessage[]
  archivePolicies  ArchivePolicy[]
  storageSnapshots StorageSnapshot[]

  @@index([organizationId])
  @@index([domainId])
  @@map("mailboxes")
}

/// Encrypted mailbox secret (envelope encryption, see architecture doc §5).
/// Kept in its own table so no ordinary query ever selects ciphertext.
model MailboxCredential {
  mailboxId     String         @id @map("mailbox_id") @db.Uuid
  type          CredentialType @default(PASSWORD)
  username      String // usually the full address; stored separately in case provider differs
  ciphertext    Bytes // AES-256-GCM(secret)
  iv            Bytes // 12-byte nonce
  authTag       Bytes          @map("auth_tag") // 16-byte GCM tag
  wrappedDek    Bytes          @map("wrapped_dek") // data key encrypted by KMS/master key
  keyId         String         @map("key_id") // which KEK wrapped the DEK (rotation)
  version       Int            @default(1) // bumped on every rotation; part of AAD
  lastVerifiedAt DateTime?     @map("last_verified_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@map("mailbox_credentials")
}

/// Explicit user ↔ mailbox authorisation. No row → no access, regardless of role.
model MailboxAccess {
  userId      String            @map("user_id") @db.Uuid
  mailboxId   String            @map("mailbox_id") @db.Uuid
  role        MailboxAccessRole
  grantedById String?           @map("granted_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  user      User    @relation("AccessUser", fields: [userId], references: [id], onDelete: Cascade)
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("AccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, mailboxId])
  @@index([mailboxId])
  @@map("mailbox_access")
}

// -----------------------------------------------------------------------------
// Live-mail metadata cache (IMAP is the source of truth)
// -----------------------------------------------------------------------------

model MailFolder {
  id            String           @id @default(uuid(7)) @db.Uuid
  mailboxId     String           @map("mailbox_id") @db.Uuid
  path          String // full IMAP path, e.g. "INBOX.Sent"
  delimiter     String?
  name          String // display name (last path segment, decoded from modified UTF-7)
  specialUse    FolderSpecialUse @default(NONE) @map("special_use")
  subscribed    Boolean          @default(true)
  selectable    Boolean          @default(true)

  // IMAP sync state
  uidValidity   BigInt?          @map("uid_validity")
  uidNext       BigInt?          @map("uid_next")
  highestModSeq BigInt?          @map("highest_mod_seq")
  totalCount    Int              @default(0) @map("total_count")
  unreadCount   Int              @default(0) @map("unread_count")
  /// Lowest UID we have metadata for (backfill cursor; null = fully backfilled)
  backfillCursorUid BigInt?      @map("backfill_cursor_uid")
  lastSyncedAt  DateTime?        @map("last_synced_at")

  mailbox  Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messages MessageMeta[]

  @@unique([mailboxId, path])
  @@index([mailboxId, specialUse])
  @@map("mail_folders")
}

/// Envelope-level metadata for one message in one folder. Bodies and
/// attachments are NOT stored here — they are fetched from IMAP on demand.
model MessageMeta {
  id            String    @id @default(uuid(7)) @db.Uuid
  mailboxId     String    @map("mailbox_id") @db.Uuid
  folderId      String    @map("folder_id") @db.Uuid
  uidValidity   BigInt    @map("uid_validity")
  uid           BigInt
  modSeq        BigInt?   @map("mod_seq")

  messageIdHeader String? @map("message_id_header")
  inReplyTo     String?   @map("in_reply_to")
  references    String[]
  threadKey     String?   @map("thread_key") // computed conversation id

  subject       String?
  fromName      String?   @map("from_name")
  fromAddress   String?   @map("from_address")
  toAddrs       Json      @default("[]") @map("to_addrs") // [{name,address}]
  ccAddrs       Json      @default("[]") @map("cc_addrs")
  bccAddrs      Json      @default("[]") @map("bcc_addrs") // only present on Sent/Drafts
  replyTo       Json      @default("[]") @map("reply_to")
  sentAt        DateTime? @map("sent_at") // Date: header
  internalDate  DateTime  @map("internal_date") // server receive time
  sizeBytes     Int       @map("size_bytes")

  flags         String[] // raw IMAP flags incl. keywords
  isSeen        Boolean   @default(false) @map("is_seen")
  isFlagged     Boolean   @default(false) @map("is_flagged") // "starred"
  isAnswered    Boolean   @default(false) @map("is_answered")
  isDraft       Boolean   @default(false) @map("is_draft")
  hasAttachments Boolean  @default(false) @map("has_attachments")
  preview       String?   @db.VarChar(300) // plain-text snippet

  /// Set when an archive copy exists in S3 (links to ArchivedMessage).
  archivedMessageId String? @map("archived_message_id") @db.Uuid

  searchVector  Unsupported("tsvector")? @map("search_vector")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  mailbox Mailbox    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folder  MailFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, uidValidity, uid])
  @@index([folderId, internalDate(sort: Desc)])
  @@index([mailboxId, internalDate(sort: Desc)])
  @@index([mailboxId, messageIdHeader])
  @@index([mailboxId, threadKey])
  @@index([folderId, isSeen])
  @@map("message_meta")
  // raw migration adds:
  //   GIN(search_vector), GIN(from_address gin_trgm_ops), GIN(subject gin_trgm_ops)
}

/// Server-side autosave buffer for the composer (crash safety). On explicit
/// "Save draft" the MIME is APPENDed to the IMAP Drafts folder.
model ComposeDraft {
  id          String   @id @default(uuid(7)) @db.Uuid
  mailboxId   String   @map("mailbox_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// IMAP Drafts UID of the last saved copy (replaced on each save).
  imapDraftUid BigInt? @map("imap_draft_uid")
  mode        String   @default("new") // new | reply | replyAll | forward
  sourceMessageId String? @map("source_message_id") @db.Uuid
  payload     Json // {to,cc,bcc,subject,html,attachmentRefs[]}
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mailboxId, userId])
  @@map("compose_drafts")
}

// -----------------------------------------------------------------------------
// Contacts & signatures (per mailbox → mailbox isolation preserved)
// -----------------------------------------------------------------------------

model Contact {
  id         String        @id @default(uuid(7)) @db.Uuid
  mailboxId  String        @map("mailbox_id") @db.Uuid
  email      String // lower-cased
  name       String?
  company    String?
  notes      String?
  source     ContactSource @default(MANUAL)
  useCount   Int           @default(0) @map("use_count") // ranking for autocomplete
  lastUsedAt DateTime?     @map("last_used_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, email])
  @@index([mailboxId, useCount(sort: Desc)])
  @@map("contacts")
  // raw migration adds trigram GIN on (email, name) for prefix/fuzzy autocomplete
}

model Signature {
  id             String   @id @default(uuid(7)) @db.Uuid
  mailboxId      String   @map("mailbox_id") @db.Uuid
  /// null = shared signature for everyone using this mailbox
  userId         String?  @map("user_id") @db.Uuid
  name           String
  html           String // sanitised on save
  isDefaultNew   Boolean  @default(false) @map("is_default_new")
  isDefaultReply Boolean  @default(false) @map("is_default_reply")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mailboxId, userId])
  @@map("signatures")
}

// -----------------------------------------------------------------------------
// Archive vault (S3) — independent of MilesWeb storage
// -----------------------------------------------------------------------------

model ArchiveBatch {
  id            String             @id @default(uuid(7)) @db.Uuid
  mailboxId     String             @map("mailbox_id") @db.Uuid
  requestedById String?            @map("requested_by_id") @db.Uuid
  trigger       ArchiveTrigger     @default(MANUAL)
  policyId      String?            @map("policy_id") @db.Uuid
  status        ArchiveBatchStatus @default(QUEUED)
  totalCount    Int                @default(0) @map("total_count")
  verifiedCount Int                @default(0) @map("verified_count")
  failedCount   Int                @default(0) @map("failed_count")
  totalBytes    BigInt             @default(0) @map("total_bytes")
  createdAt     DateTime           @default(now()) @map("created_at")
  completedAt   DateTime?          @map("completed_at")

  mailbox     Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  requestedBy User?             @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  policy      ArchivePolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  messages    ArchivedMessage[]

  @@index([mailboxId, createdAt(sort: Desc)])
  @@map("archive_batches")
}

model ArchivedMessage {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  mailboxId      String        @map("mailbox_id") @db.Uuid
  batchId        String?       @map("batch_id") @db.Uuid
  status         ArchiveStatus @default(PENDING)
  failureReason  String?       @map("failure_reason")

  // --- S3 object ----------------------------------------------------------
  s3Bucket       String?       @map("s3_bucket")
  s3Key          String?       @map("s3_key")
  s3VersionId    String?       @map("s3_version_id")
  sha256         String // hex SHA-256 of the exact RFC 822 bytes
  sizeBytes      BigInt        @map("size_bytes")
  storageClass   String?       @map("storage_class")
  verifiedAt     DateTime?     @map("verified_at")

  // --- provenance (where it came from in the live mailbox) ----------------
  originalFolderPath  String   @map("original_folder_path")
  originalUidValidity BigInt   @map("original_uid_validity")
  originalUid         BigInt   @map("original_uid")
  originalFlags       String[] @map("original_flags")
  internalDate        DateTime @map("internal_date")

  // --- searchable metadata ------------------------------------------------
  messageIdHeader String?   @map("message_id_header")
  subject         String?
  fromName        String?   @map("from_name")
  fromAddress     String?   @map("from_address")
  toAddrs         Json      @default("[]") @map("to_addrs")
  ccAddrs         Json      @default("[]") @map("cc_addrs")
  bccAddrs        Json      @default("[]") @map("bcc_addrs")
  sentAt          DateTime? @map("sent_at")
  hasAttachments  Boolean   @default(false) @map("has_attachments")
  textExcerpt     String?   @map("text_excerpt") // first ~32 KB of plain text, for FTS
  searchVector    Unsupported("tsvector")? @map("search_vector")

  // --- live copy lifecycle (deletion only after VERIFIED + confirmation) --
  liveCopyState     LiveCopyState @default(PRESENT) @map("live_copy_state")
  liveCopyChangedAt DateTime?     @map("live_copy_changed_at")
  liveCopyChangedBy String?       @map("live_copy_changed_by") @db.Uuid
  restoredAt        DateTime?     @map("restored_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mailbox     Mailbox             @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  batch       ArchiveBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attachments ArchiveAttachment[]

  /// Content-addressed: archiving the same bytes twice is idempotent.
  @@unique([mailboxId, sha256])
  @@index([mailboxId, sentAt(sort: Desc)])
  @@index([mailboxId, status])
  @@map("archived_messages")
}

/// Attachment inventory of an archived EML (bytes stay inside the EML in S3).
model ArchiveAttachment {
  id                String  @id @default(uuid(7)) @db.Uuid
  archivedMessageId String  @map("archived_message_id") @db.Uuid
  partId            String  @map("part_id") // MIME part path, e.g. "2.1"
  filename          String?
  contentType       String  @map("content_type")
  sizeBytes         Int     @map("size_bytes")
  sha256            String?
  isInline          Boolean @default(false) @map("is_inline")

  archivedMessage ArchivedMessage @relation(fields: [archivedMessageId], references: [id], onDelete: Cascade)

  @@index([archivedMessageId])
  @@map("archive_attachments")
}

/// Future automated archival (schema only in v1; no scheduler UI yet).
model ArchivePolicy {
  id            String    @id @default(uuid(7)) @db.Uuid
  mailboxId     String    @map("mailbox_id") @db.Uuid
  enabled       Boolean   @default(false)
  olderThanDays Int       @map("older_than_days") // e.g. 365
  folderPaths   String[]  @map("folder_paths") // empty = all except Drafts/Trash/Junk
  /// Policies NEVER remove originals automatically in v1; they only archive
  /// and then notify the owner to confirm removal.
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  mailbox Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  batches ArchiveBatch[]

  @@map("archive_policies")
}

// -----------------------------------------------------------------------------
// Observability & compliance
// -----------------------------------------------------------------------------

model StorageSnapshot {
  id         String      @id @default(uuid(7)) @db.Uuid
  mailboxId  String      @map("mailbox_id") @db.Uuid
  usedBytes  BigInt      @map("used_bytes")
  limitBytes BigInt?     @map("limit_bytes")
  archiveBytes BigInt    @default(0) @map("archive_bytes")
  source     QuotaSource
  takenAt    DateTime    @default(now()) @map("taken_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId, takenAt(sort: Desc)])
  @@map("storage_snapshots")
}

/// Append-only. The application DB role is granted INSERT/SELECT only on this
/// table (no UPDATE/DELETE) via a raw migration.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid // null = system/worker
  mailboxId      String?  @map("mailbox_id") @db.Uuid
  action         String // e.g. "auth.login.success", "archive.live_copy.expunge"
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json     @default("{}") // NEVER contains secrets or message bodies
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([mailboxId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
