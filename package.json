{
  "name": "matiummail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "keys:generate": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "db:migrate:remote": "tsx --conditions=react-server scripts/migrate-remote.ts",
    "db:status:remote": "tsx --conditions=react-server scripts/migrate-remote.ts --status",
    "db:migration:new": "sh scripts/new-migration.sh"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "imapflow": "2.12.1",
    "lucide-react": "^1.73.0",
    "mailparser": "3.14.5",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.6.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mariadb": "3.5.4",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
